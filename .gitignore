# artefactos de compilación LaTeX
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.dvi
# sitio y cachés
_site/
.quarto/
.work/
*.sha
__pycache__/

/.quarto/
**/*.quarto_ipynb

# Publico/ es un ARTEFACTO: lo construye herramientas/publicar.sh por
# lista blanca y será su propio repositorio; no se versiona aquí
/Publico/

# pdf: artefactos de compilación; el de la obra completa es el
# producto de pago y NUNCA se publica
latex/main.pdf
latex/figs/**/*.pdf
# excepción: el logo editorial de la portada es recurso, no artefacto
!latex/figs/portada/qword_editorial_5.5cm.pdf

# el FUENTE del libro no sube a GitHub JAMÁS (tampoco en privado):
# latex/ tiene su propio git LOCAL sin remoto; qmd/ es generado
/latex/
/qmd/

# .md de implementación: JAMÁS suben al repositorio (política §4.2)
/ESTADO.md
/Bibliografia.md
